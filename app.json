{
  "expo": {
    "name": "Gameday",
    "slug": "Gameday",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hearsigns.Gameday",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification", "processing"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.hearsigns.Gameday"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-background-task",
      [
        "expo-calendar",
        {
          "calendarPermission": "Gameday adds your followed teams' fixtures to your calendar and keeps them up to date."
        }
      ],
      "expo-notifications"
    ]
  }
}
